# 查课管理系统后端环境配置示例
# 复制为 .env 后按实际环境填写；.env 不得提交到仓库。
# 密钥类配置（数据库密码、令牌密钥、微信 AppSecret、对象存储凭证）通过受保护环境配置注入。

# ---- 应用 ----
APP_ENV=dev                      # dev / test / prod
DEBUG=true

# ---- 数据库 (SQLAlchemy 同步 + PyMySQL) ----
# 形如 mysql+pymysql://user:password@host:3306/course_management?charset=utf8mb4
# 与 deploy/docker-compose.yml 对齐（开发库）
DATABASE_URL=mysql+pymysql://cm_app:change_me_app@127.0.0.1:3306/course_management?charset=utf8mb4
# 集成/并发测试使用的独立测试库（由 docker-compose 初始化脚本创建）
# TEST_DATABASE_URL=mysql+pymysql://cm_app:change_me_app@127.0.0.1:3306/course_management_test?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800             # 适配 MySQL wait_timeout 的空闲连接回收

# ---- 安全 / 令牌 ----
# 生产环境务必替换为强随机值，切勿使用示例值
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Web 刷新令牌 Cookie / CSRF (技术方案 7.1) ----
# refresh 经 HttpOnly Cookie 下发。COOKIE_SECURE 生产必须为 true（HTTPS）；
# 本地 http://localhost 调试若置 true，浏览器会丢弃该 Cookie，可临时设为 false。
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax              # lax / strict / none（none 需配合 Secure 即 HTTPS）
# COOKIE_DOMAIN=                 # 跨子域共享时填写；同源部署留空
# Cookie 承载写接口 /auth/refresh 的 CSRF 允许来源（逗号分隔），同源部署通常留空。
CSRF_ALLOWED_ORIGINS=

# ---- CORS (Web 管理端同源部署时通常留空) ----
CORS_ORIGINS=

# ---- 日志 ----
LOG_LEVEL=INFO
