/**app.wxss**/
.container {
  box-sizing: border-box;
  width: 100%;
} 

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

page {
  background: #F8FAFC;
  /* Modern Minimalist Light Blue - Tech Style */
  --primary-color: #60A5FA;
  --td-brand-color: var(--primary-color);
  --td-brand-color-light: #aeb4bd;
  --td-brand-color-focus: #3B82F6;
  --td-brand-color-active: #2563EB;
  --td-brand-color-disabled: #BFDBFE;
}