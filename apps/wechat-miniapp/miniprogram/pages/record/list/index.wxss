.container {
  min-height: 100vh;
  background-color: #F8FAFC;
}

.record-list {
  padding: 32rpx;
}

.record-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.info-row {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.info-row .label {
  color: #94A3B8;
}
.info-row .value {
  color: #334155;
}

.action-bar {
  display: flex;
  justify-content: flex-end;
  border-top: 1px solid #F1F5F9;
  padding-top: 24rpx;
  margin-top: 24rpx;
}

.empty-wrap {
  margin-top: 120rpx;
}
