.container {
  min-height: 100vh;
  background-color: #F8FAFC;
}

.record-list {
  padding: 32rpx;
}

.record-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.info-row {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.info-row .label {
  color: #94A3B8;
}
.info-row .value {
  color: #334155;
}

.action-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  border-top: 1px solid #F1F5F9;
  padding-top: 24rpx;
  margin-top: 24rpx;
}

.empty-wrap {
  margin-top: 120rpx;
}

/* 弹窗遮罩层 */
.detail-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(2px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 弹窗主体卡片 */
.detail-modal-card {
  width: 100%;
  max-width: 640rpx;
  background-color: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  max-height: 84vh;
}

/* 头部 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0F172A;
}

.modal-close-btn {
  font-size: 36rpx;
  color: #94A3B8;
  padding: 8rpx 16rpx;
  line-height: 1;
}

/* 滚动区域 */
.modal-scroll-body {
  padding: 28rpx 36rpx;
  box-sizing: border-box;
  max-height: 60vh;
}

/* 课程信息小卡片 */
.detail-info-card {
  background-color: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.modal-course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.modal-meta-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.meta-label {
  color: #64748B;
}

.meta-val {
  color: #334155;
  font-weight: 500;
}

/* 内容区块 */
.detail-block {
  margin-bottom: 24rpx;
}

.block-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.block-title .dot {
  width: 8rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background-color: #3B82F6;
  margin-right: 12rpx;
}

.block-title .dot.primary {
  background-color: #3B82F6;
}

.block-title .dot.warning {
  background-color: #F59E0B;
}

/* 理由与批注内容框 */
.reason-content-box {
  background-color: #F1F5F9;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  color: #334155;
  line-height: 1.6;
  word-break: break-all;
}

.review-comment-box {
  background-color: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.comment-label {
  color: #64748B;
  font-weight: 500;
}

.comment-content {
  color: #1E293B;
  word-break: break-all;
}

.review-empty-comment {
  font-size: 26rpx;
  color: #94A3B8;
  font-style: italic;
  padding: 12rpx 0;
}

/* 重新申诉提示栏 */
.reappeal-banner {
  background-color: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-top: 12rpx;
}

.reappeal-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D4ED8;
  margin-bottom: 6rpx;
}

.reappeal-desc {
  font-size: 24rpx;
  color: #2563EB;
  line-height: 1.5;
}

/* 底部操作区 */
.modal-footer {
  display: flex;
  padding: 24rpx 36rpx 32rpx;
  border-top: 1rpx solid #F1F5F9;
  background-color: #ffffff;
}
