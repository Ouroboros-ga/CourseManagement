<view class="container">
  <view class="record-read-error" wx:if="{{recordsError}}">{{recordsError}}</view>
  <view class="record-read-error" wx:if="{{objectionsError}}">{{objectionsError}}</view>
  <view class="record-list">
    <block wx:if="{{records.length > 0}}">
      <view class="record-card" wx:for="{{records}}" wx:key="id">
        <view class="card-header">
          <view class="course-name">{{item.courseName}}</view>
          <view class="custom-tag {{item.statusTagClass}}">
            {{item.type || item.status}}
          </view>
        </view>
        <view class="info-row">
          <text class="label">时间：</text>
          <text class="value">{{item.date}}</text>
        </view>
        <view class="info-row">
          <text class="label">班级：</text>
          <text class="value">{{item.className}}</text>
        </view>

        <view class="action-bar" wx:if="{{objectionsReady && item.status !== '正常' && item.status !== '已撤销' && !item.objectionStatusStr}}">
          <t-button size="small" theme="primary" bind:tap="goToAppeal" data-id="{{item.id}}">提出异议</t-button>
        </view>
        <view class="action-bar" wx:elif="{{objectionsReady && item.objectionStatusStr}}">
          <view class="custom-tag {{item.objectionTagClass}}" bind:tap="showObjectionDetail" data-record="{{item}}">
            {{item.objectionStatusStr}} · 详情
          </view>
          <t-button wx:if="{{item.canReAppeal}}" size="small" theme="primary" variant="outline" bind:tap="goToAppeal" data-id="{{item.id}}" data-reappeal="1">重新申诉</t-button>
        </view>
      </view>
    </block>
    <view wx:elif="{{!recordsError}}" class="empty-wrap">
      <t-empty icon="info-circle" description="暂无查课记录" />
    </view>
  </view>

  <!-- 异议进度与详情弹窗 -->
  <view class="detail-modal-mask" wx:if="{{showDetailModal}}" bind:tap="closeDetailModal">
    <view class="detail-modal-card" catch:tap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">异议进度与详情</text>
        <view class="modal-close-btn" bind:tap="closeDetailModal">✕</view>
      </view>

      <scroll-view scroll-y class="modal-scroll-body">
        <!-- 课程与考勤事实 -->
        <view class="detail-info-card">
          <view class="modal-course-name">{{selectedRecord.courseName}}</view>
          <view class="modal-meta-row">
            <text class="meta-label">考勤日期：</text>
            <text class="meta-val">{{selectedRecord.date}}</text>
          </view>
          <view class="modal-meta-row">
            <text class="meta-label">考勤结果：</text>
            <view class="custom-tag {{selectedRecord.statusTagClass}}" style="margin-left: 8rpx;">
              {{selectedRecord.status}}
            </view>
          </view>
        </view>

        <!-- 申诉诉求与理由 -->
        <view class="detail-block">
          <view class="block-title">
            <text class="dot"></text>
            <text>申诉理由</text>
            <view class="custom-tag {{selectedRecord.objectionTagClass}}" style="margin-left: auto;">
              {{selectedRecord.objectionStatusStr}}
            </view>
          </view>
          <view class="reason-content-box">
            {{selectedRecord.objection.reason || '未填写理由'}}
          </view>
        </view>

        <view class="detail-block progress-block" wx:if="{{progressVisible}}">
          <view class="block-title">
            <text class="dot primary"></text><text>办理进度</text>
          </view>
          <view class="progress-message" wx:if="{{progressLoading}}">正在读取办理进度…</view>
          <view class="progress-error" wx:elif="{{progressError}}">{{progressError}}</view>
          <view wx:elif="{{progressData}}">
            <view class="progress-label">{{progressData.label}}</view>
            <view class="progress-message">{{progressData.description}}</view>
            <view class="progress-formal" wx:if="{{progressData.final_status !== 'PENDING'}}">
              正式结果：{{progressData.final_status === 'APPROVED' ? '申诉已通过' : '申诉已驳回'}}。请下拉刷新记录，核对最新考勤。
            </view>
          </view>
          <t-button size="small" variant="outline" loading="{{progressLoading}}" disabled="{{progressLoading}}" bind:tap="refreshProgress">刷新进度</t-button>
        </view>

        <!-- 初审结果 (若已流转) -->
        <view class="detail-block" wx:if="{{selectedRecord.objection.initial_status && selectedRecord.objection.initial_status !== 'PENDING'}}">
          <view class="block-title">
            <text class="dot primary"></text>
            <text>历史初核记录</text>
            <view class="custom-tag {{selectedRecord.objection.initial_status === 'APPROVED' ? 'tag-success' : 'tag-danger'}}" style="margin-left: auto;">
              {{selectedRecord.objection.initial_status === 'APPROVED' ? '初核通过' : '初核驳回'}}
            </view>
          </view>
          <view class="review-empty-comment">仅供历史查看，不代表当前审核结论。</view>
          <view class="review-comment-box" wx:if="{{selectedRecord.objection.initial_comment}}">
            <text class="comment-label">初审意见：</text>
            <text class="comment-content">{{selectedRecord.objection.initial_comment}}</text>
          </view>
          <view class="review-empty-comment" wx:else>未填写初审批注</view>
        </view>

        <!-- 终审结果 (若已流转) -->
        <view class="detail-block" wx:if="{{selectedRecord.objection.final_status && selectedRecord.objection.final_status !== 'PENDING'}}">
          <view class="block-title">
            <text class="dot warning"></text>
            <text>正式审核结果</text>
            <view class="custom-tag {{selectedRecord.objection.final_status === 'APPROVED' ? 'tag-success' : 'tag-danger'}}" style="margin-left: auto;">
              {{selectedRecord.objection.final_status === 'APPROVED' ? '终审通过' : '终审驳回'}}
            </view>
          </view>
          <view class="review-comment-box" wx:if="{{selectedRecord.objection.final_comment}}">
            <text class="comment-label">终审意见：</text>
            <text class="comment-content">{{selectedRecord.objection.final_comment}}</text>
          </view>
          <view class="review-empty-comment" wx:else>未填写终审批注</view>
        </view>

        <!-- 重新申诉提示 -->
        <view class="reappeal-banner" wx:if="{{selectedRecord.canReAppeal}}">
          <view class="reappeal-title">💡 申诉窗口期提示</view>
          <view class="reappeal-desc">该异议已终审归档，您仍在 7 天窗口期内，可重新提交材料发起异议。</view>
        </view>
      </scroll-view>

      <view class="modal-footer">
        <t-button wx:if="{{selectedRecord.canReAppeal}}" theme="primary" variant="outline" size="medium" bind:tap="handleModalReAppeal" style="flex: 1; margin-right: 16rpx;">
          重新申诉
        </t-button>
        <t-button theme="primary" size="medium" bind:tap="closeDetailModal" style="flex: 1;">
          我知道了
        </t-button>
      </view>
    </view>
  </view>
</view>
