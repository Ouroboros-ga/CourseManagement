<view class="container">
  <view class="form-card">
    <view class="section-title">异议理由</view>
    <t-textarea value="{{reason}}" bind:change="onReasonChange" placeholder="请详细说明您的异议理由" maxlength="200" disableDefaultPadding="{{true}}" />
  </view>

  <view class="form-card">
    <view class="section-title flex-between">
      <text>证明材料</text>
      <text class="hint">选填，最多3张</text>
    </view>
    <t-upload
      mediaType="{{['image']}}"
      max="3"
      files="{{fileList}}"
      bind:add="onAddPhoto"
      bind:remove="onRemovePhoto"
    />
  </view>

  <view class="footer-btn">
    <t-button theme="primary" size="large" block bind:tap="handleSubmit">提交异议</t-button>
  </view>
  <t-toast id="t-toast" />
</view>
