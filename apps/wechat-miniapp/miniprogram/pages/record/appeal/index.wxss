.container {
  min-height: 100vh;
  background-color: #F8FAFC;
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.form-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 24rpx;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hint {
  font-size: 26rpx;
  color: #94A3B8;
  font-weight: 400;
}

/* 覆盖 textarea 边距使其自然 */
.t-textarea {
  padding: 0 !important;
}

.footer-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 100;
}
