<view class="container">
  <!-- 任务基础信息 -->
  <view class="info-card">
    <view class="title">{{task.courseName}}</view>
    <view class="desc" wx:if="{{task.timeStr}}">{{task.timeStr}} · {{task.classroom}}</view>
    <view class="desc">班级：{{task.className}}</view>
    <view class="desc">应到人数：{{task.expectedCount}}人</view>
    <view class="desc" wx:if="{{task.status === '已取消' && task.canceledAtStr}}">取消时间：{{task.canceledAtStr}}</view>
    <view class="desc" wx:elif="{{task.deadlineStr}}">截止时间：{{task.deadlineStr}}</view>
  </view>

  <!-- 待执行状态 -->
  <block wx:if="{{task.status === '待执行'}}">
    <t-notice-bar wx:if="{{task.isFuture}}" visible="{{true}}" theme="warning" content="该任务查课日期为 {{task.inspection_date || task.date}}，只能在查课当天及以后上传数据。" />
    <t-notice-bar wx:elif="{{rejectedReason}}" visible="{{true}}" theme="error" content="上次提交已被驳回：{{rejectedReason}}" />
    
    <view class="section-title">查课结果</view>
    <view class="radio-card">
      <t-radio-group value="{{resultType}}" bind:change="onResultTypeChange">
        <t-radio value="NORMAL" label="全部正常 (无迟到、旷课、请假)" />
        <t-radio value="ABNORMAL" label="存在异常学生" />
      </t-radio-group>
    </view>

    <!-- 异常学生列表 (仅在选了异常时展示) -->
    <block wx:if="{{resultType === 'ABNORMAL'}}">
      <view class="section-title flex-between">
        <text>异常名单 ({{abnormalList.length}}人)</text>
        <t-button size="small" theme="primary" variant="text" bind:tap="goToAbnormalPage">
          添加学生
        </t-button>
      </view>
      
      <view class="abnormal-card" wx:if="{{abnormalList.length > 0}}">
        <view class="student-item" wx:for="{{abnormalList}}" wx:key="studentId">
          <view class="stu-info">
            <text class="stu-name">{{item.name}}</text>
            <text class="stu-no">{{item.studentId}}</text>
          </view>
          <t-tag theme="{{item.type === '请假' ? 'warning' : 'danger'}}" variant="light">
            {{item.type}}
          </t-tag>
        </view>
      </view>
      <view class="abnormal-card empty-hint" wx:else bind:tap="goToAbnormalPage">
        点击此处添加异常学生
      </view>
    </block>

    <!-- 照片上传 -->
    <view class="section-title" wx:if="{{task.requirePhoto}}">现场照片 (必填)</view>
    <view class="section-title" wx:else>现场照片 (选填)</view>
    <view class="upload-card">
      <t-upload
        mediaType="{{['image']}}"
        max="3"
        files="{{fileList}}"
        bind:add="onAddPhoto"
        bind:remove="onRemovePhoto"
      />
    </view>

    <view class="footer-btn">
      <t-button theme="primary" size="large" block disabled="{{task.isFuture}}" bind:tap="handleSubmit">
        {{task.isFuture ? '尚未到查课日期 (未开放上传)' : '提交记录'}}
      </t-button>
    </view>
  </block>

  <!-- 已取消 (停课免查) -->
  <view wx:elif="{{task.status === '已取消'}}" class="readonly-mode">
    <t-notice-bar visible="{{true}}" theme="warning" content="【停课免查】{{task.cancel_reason ? '原因：' + task.cancel_reason : '该任务因校历/教师停课已取消免查，无需前往。'}}" />
    
    <view class="section-title">停课免查说明</view>
    <view class="cancel-card">
      <view class="cancel-desc">
        <text class="cancel-title">免查原因：</text>
        <text class="cancel-detail">{{task.cancel_reason || '教务处/校历停课安排'}}</text>
      </view>
      <view class="cancel-desc" wx:if="{{task.canceledAtStr}}">
        <text class="cancel-title">取消时间：</text>
        <text class="cancel-detail">{{task.canceledAtStr}}</text>
      </view>
      <view class="cancel-tip">
        本任务已被系统标记为停课免查，不计入考勤违规或逾期未检，无需前往现场查课。
      </view>
    </view>
  </view>

  <view wx:else class="readonly-mode">
    <t-notice-bar visible="{{true}}" theme="warning" content="当前任务状态为「{{task.status}}」，已归档或锁定，无法修改。" />
    
    <block wx:if="{{hasSubmission}}">
      <t-notice-bar wx:if="{{reviewStatus === 'REJECTED'}}" visible="{{true}}" theme="error" content="该提交已被驳回：{{rejectedReason}}" />
      <t-notice-bar wx:elif="{{reviewStatus === 'PENDING'}}" visible="{{true}}" theme="info" content="该提交正在等待管理审核" />
      
      <view class="section-title">我的提交记录</view>
      <view class="radio-card">
        <view class="result-text">{{resultType === 'NORMAL' ? '全部正常 (无迟到、旷课、请假)' : '存在异常学生'}}</view>
      </view>
      
      <block wx:if="{{resultType === 'ABNORMAL'}}">
        <view class="section-title">异常名单 ({{abnormalList.length}}人)</view>
        <view class="abnormal-card" wx:if="{{abnormalList.length > 0}}">
          <view class="student-item" wx:for="{{abnormalList}}" wx:key="studentId">
            <view class="stu-info">
              <text class="stu-name">{{item.name}}</text>
              <text class="stu-no">{{item.studentId}}</text>
            </view>
            <t-tag theme="{{item.type === '请假' ? 'warning' : 'danger'}}" variant="light">
              {{item.type}}
            </t-tag>
          </view>
        </view>
      </block>
    </block>
  </view>
  
  <t-toast id="t-toast" />
</view>
