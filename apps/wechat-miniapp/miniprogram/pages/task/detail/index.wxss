.container {
  padding: 32rpx;
  background-color: #F8FAFC;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.info-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #64748B;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 16rpx;
  margin-top: 40rpx;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.radio-card, .abnormal-card, .upload-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.abnormal-card {
  padding: 0;
  overflow: hidden;
}

.student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid #F1F5F9;
}
.student-item:last-child {
  border-bottom: none;
}

.stu-info {
  display: flex;
  align-items: center;
}
.stu-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1E293B;
  margin-right: 16rpx;
}
.stu-no {
  font-size: 24rpx;
  color: #94A3B8;
}

.empty-hint {
  padding: 48rpx;
  text-align: center;
  color: #94A3B8;
  font-size: 28rpx;
}

.upload-card {
  padding: 32rpx;
}

.footer-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.footer-shift-link {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

.footer-shift-action {
  color: #3B82F6;
  font-weight: 500;
  margin-left: 6rpx;
}

.readonly-mode {
  margin-top: 20rpx;
}

.result-text {
  font-size: 30rpx;
  color: #334155;
  padding: 16rpx 32rpx;
}

.cancel-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.cancel-desc {
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.cancel-title {
  color: #64748B;
}

.cancel-detail {
  color: #D97706;
  font-weight: 500;
}

.cancel-tip {
  font-size: 26rpx;
  color: #94A3B8;
  line-height: 1.5;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F5F9;
}

.change-dialog-content {
  text-align: left;
  padding: 12rpx 0;
}

.change-tip {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.pending-tip {
  text-align: center;
  font-size: 24rpx;
  color: #d97706;
  margin-top: 16rpx;
/* 换班驳回详情卡片 */
.reject-card {
  background-color: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.05);
}

.reject-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.reject-header-left {
  display: flex;
  align-items: center;
}

.reject-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #B91C1C;
  margin-left: 12rpx;
}

.reject-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reject-row {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.5;
}

.reject-label {
  color: #7F1D1D;
  font-weight: 500;
  flex-shrink: 0;
}

.reject-content {
  color: #450A0A;
  flex: 1;
  word-break: break-all;
}

.reject-comment {
  font-weight: 600;
  color: #DC2626;
}

.reject-tip {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #FECACA;
  font-size: 24rpx;
  color: #991B1B;
  line-height: 1.4;
}
