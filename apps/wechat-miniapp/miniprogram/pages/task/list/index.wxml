<view class="container">
  <t-tabs defaultValue="TODO" bind:change="onTabChange" sticky theme="card">
    <t-tab-panel label="待执行" value="TODO" />
    <t-tab-panel label="已提交" value="DONE" />
    <t-tab-panel label="已结束" value="CLOSED" />
  </t-tabs>

  <view class="task-list">
    <block wx:if="{{tasks.length > 0}}">
      <view class="task-card" wx:for="{{tasks}}" wx:key="id" bind:tap="goToDetail" data-id="{{item.id}}">
        <view class="task-header">
          <view class="task-title">{{item.courseName}}</view>
          <view class="custom-tag {{item.statusTagClass}}">
            {{item.displayStatus || item.status}}
          </view>
        </view>
        <view class="task-info">
          <view class="info-row" wx:if="{{item.status === '已取消'}}">
            <t-icon name="close-circle-filled" size="32rpx" color="#F59E0B" />
            <text class="info-text cancel-reason-text">{{item.cancel_reason ? '停课免查：' + item.cancel_reason : '已停课免查'}}</text>
          </view>
          <view class="info-row">
            <t-icon name="time" size="32rpx" color="#94A3B8" />
            <text class="info-text">{{item.timeStr}}</text>
          </view>
          <view class="info-row">
            <t-icon name="location" size="32rpx" color="#94A3B8" />
            <text class="info-text">{{item.classroom}}</text>
          </view>
          <view class="info-row">
            <t-icon name="usergroup" size="32rpx" color="#94A3B8" />
            <text class="info-text">{{item.className}}</text>
          </view>
          <view class="reject-hint-row" wx:if="{{item.isChangeRejected}}">
            <t-icon name="error-circle-filled" size="28rpx" color="#EF4444" />
            <text class="reject-hint-text">换班申请已被驳回{{item.changeRejectComment ? '：' + item.changeRejectComment : ''}}</text>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-wrap">
      <t-empty icon="info-circle" description="暂无任务" />
    </view>
  </view>
</view>
