.container {
  min-height: 100vh;
  background-color: #F8FAFC;
}

.task-list {
  padding: 32rpx;
}

.task-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.task-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #64748B;
}

.cancel-reason-text {
  color: #D97706;
  font-weight: 500;
}

.empty-wrap {
  margin-top: 120rpx;
}

.reject-hint-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #FEE2E2;
}

.reject-hint-text {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #EF4444;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
