<view class="container">
  <view class="search-bar">
    <t-search value="{{keyword}}" bind:change="onKeywordChange" placeholder="输入姓名或学号搜索" action="搜索" bind:action-click="handleSearch" />
  </view>

  <view class="list-container">
    <view class="student-card" wx:for="{{displayList}}" wx:key="studentId">
      <view class="student-header">
        <view class="stu-info">
          <text class="stu-name">{{item.name}}</text>
          <text class="stu-no">{{item.studentNo}}</text>
        </view>
        <t-icon 
          name="{{item._selected ? 'minus-circle' : 'add-circle'}}" 
          size="48rpx" 
          color="{{item._selected ? '#EF4444' : '#3B82F6'}}" 
          bind:tap="toggleStudent" 
          data-item="{{item}}" 
        />
      </view>
      
      <view class="type-selector" wx:if="{{item._selected}}">
        <t-radio-group value="{{item.type}}" bind:change="onTypeChange" data-studentid="{{item.studentId}}" borderless placement="horizontal">
          <t-radio value="迟到" label="迟到" />
          <t-radio value="旷课" label="旷课" />
          <t-radio value="请假" label="请假" />
        </t-radio-group>
      </view>
    </view>
    
    <view class="empty-hint" wx:if="{{displayList.length === 0}}">暂无学生数据</view>
  </view>

  <view class="footer-btn">
    <t-button theme="primary" size="large" block bind:tap="handleConfirm">确定添加 ({{selectedList.length}})</t-button>
  </view>
  
  <t-toast id="t-toast" />
</view>
