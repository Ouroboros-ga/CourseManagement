.container {
  min-height: 100vh;
  background-color: #F8FAFC;
}

.list-wrap {
  padding: 32rpx;
}

.approval-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.stu-info .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
  margin-right: 16rpx;
}
.stu-info .no {
  font-size: 26rpx;
  color: #94A3B8;
}

.course-info {
  font-size: 28rpx;
  color: #64748B;
  margin-bottom: 24rpx;
}

.reason-box {
  background-color: #F1F5F9;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}
.reason-box .label {
  color: #64748B;
}
.reason-box .content {
  color: #334155;
}

.proof-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.proof-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #F1F5F9;
}

.action-bar {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  border-top: 1px solid #F1F5F9;
  padding-top: 24rpx;
}

.empty-wrap {
  margin-top: 120rpx;
}
