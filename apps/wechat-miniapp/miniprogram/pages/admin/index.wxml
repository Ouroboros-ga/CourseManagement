<view class="container">
  <t-tabs defaultValue="0" sticky theme="card">
    <t-tab-panel label="查课审核" value="0">
      <view class="list-wrap">
        <block wx:if="{{submissions.length > 0}}">
          <view class="approval-card" wx:for="{{submissions}}" wx:key="id">
            <view class="card-header">
              <view class="stu-info">
                <text class="name">{{item.task.course_name_snapshot || '未知课程'}}</text>
              </view>
              <t-tag theme="{{item.result === 'NORMAL' ? 'success' : 'danger'}}" variant="light">
                {{item.result === 'NORMAL' ? '全勤' : '有异常'}}
              </t-tag>
            </view>
            <view class="course-info">
              班级：{{item.task.class_name_snapshot || '-'}} · 教室：{{item.task.classroom_snapshot || '-'}}
            </view>
            
            <view class="reason-box" wx:if="{{item.result === 'ABNORMAL'}}">
              <text class="label">异常明细：</text>
              <view class="content" wx:for="{{item.abnormal_items}}" wx:for-item="ab" wx:key="student_id">
                {{ab.name || ab.student_no || ab.student_id}} - {{ab.attendance_type === 'LATE' ? '迟到' : ab.attendance_type === 'ABSENT' ? '旷课' : ab.attendance_type === 'LEAVE' ? '请假' : ab.attendance_type}}
              </view>
            </view>

            <!-- 现场照片 -->
            <view class="proof-box" wx:if="{{item.file_ids && item.file_ids.length > 0}}">
              <!-- 这里为了简便，暂未实现获取照片真实URL，如有需要后续再对接 access 接口 -->
              <text class="label" style="font-size:24rpx;color:#999;">附有 {{item.file_ids.length}} 张现场照片</text>
            </view>
            
            <view class="action-bar">
              <t-button size="small" theme="danger" variant="outline" bind:tap="handleReviewSubmit" data-id="{{item.id}}" data-decision="REJECTED">驳回重填</t-button>
              <t-button size="small" theme="primary" bind:tap="handleReviewSubmit" data-id="{{item.id}}" data-decision="APPROVED">审核通过</t-button>
            </view>
          </view>
        </block>
        <view wx:else class="empty-wrap">
          <t-empty icon="info-circle" description="暂无待审核查课" />
        </view>
      </view>
    </t-tab-panel>

    <t-tab-panel label="异议审批" value="1">
      <view class="list-wrap">
        <block wx:if="{{approvals.length > 0}}">
          <view class="approval-card" wx:for="{{approvals}}" wx:key="id">
            <view class="card-header">
              <view class="stu-info">
                <text class="name">{{item.studentName}}</text>
                <text class="no">{{item.studentId}}</text>
              </view>
              <t-tag theme="warning" variant="light">{{item.type}}异议</t-tag>
            </view>
            <view class="course-info">
              {{item.courseName}} · {{item.date}} 第{{item.period}}节
            </view>
            <view class="reason-box">
              <text class="label">理由：</text>
              <text class="content">{{item.reason}}</text>
            </view>
            <!-- 证明材料 -->
            <view class="proof-box" wx:if="{{item.proofs && item.proofs.length > 0}}">
              <image wx:for="{{item.proofs}}" wx:for-item="url" wx:key="*this" src="{{url}}" mode="aspectFill" class="proof-img" bind:tap="previewImage" data-url="{{url}}" data-urls="{{item.proofs}}" />
            </view>
            <view class="action-bar">
              <t-button size="small" theme="danger" variant="outline" bind:tap="handleReject" data-id="{{item.id}}" data-version="{{item.base_attendance_version}}">驳回</t-button>
              <t-button size="small" theme="primary" bind:tap="handleApprove" data-id="{{item.id}}" data-version="{{item.base_attendance_version}}">同意</t-button>
            </view>
          </view>
        </block>
        <view wx:else class="empty-wrap">
          <t-empty icon="info-circle" description="暂无待审批异议" />
        </view>
      </view>
    </t-tab-panel>
  </t-tabs>
  <t-toast id="t-toast" />
</view>
