<view class="container">
  <view class="list-wrap">
    <block wx:if="{{approvals.length > 0}}">
      <view class="approval-card" wx:for="{{approvals}}" wx:key="id">
        <view class="card-header">
          <view class="stu-info">
            <text class="name">{{item.studentName}}</text>
            <text class="no">{{item.studentId}}</text>
          </view>
          <view class="custom-tag tag-warning">{{item.type}}异议</view>
        </view>
        <view class="course-info">
          {{item.courseName}} · {{item.date}}
          <view style="font-size: 24rpx; color: #999; margin-top: 4rpx;">{{item.className}}</view>
        </view>
        <view class="reason-box">
          <text class="label">申诉理由：</text>
          <text class="content">{{item.reason}}</text>
        </view>
        <!-- 证明材料 -->
        <view class="proof-box" wx:if="{{item.proofs && item.proofs.length > 0}}">
          <image wx:for="{{item.proofs}}" wx:for-item="url" wx:key="*this" src="{{url}}" mode="aspectFill" class="proof-img" bind:tap="previewImage" data-url="{{url}}" data-urls="{{item.proofs}}" />
        </view>
        <view class="action-bar">
          <t-button size="small" theme="danger" variant="outline" bind:tap="handleReject" data-id="{{item.id}}" data-version="{{item.base_attendance_version}}">驳回</t-button>
          <t-button size="small" theme="primary" bind:tap="handleApprove" data-id="{{item.id}}" data-version="{{item.base_attendance_version}}">同意</t-button>
        </view>
      </view>
    </block>
    <view wx:else class="empty-wrap">
      <t-empty icon="info-circle" description="暂无待审批异议" />
    </view>
  </view>
  <t-toast id="t-toast" />
</view>
