# MySQL 8.4 配置（查课管理系统开发用）
# 注意：MySQL 8.4 移除了 default-authentication-plugin（改用默认 caching_sha2_password），
# 且 --enforce-config-setting-validation=OFF 允许 world-writable 配置文件被加载
# （Windows bind-mount 下文件权限位会显示为 0o777）。
[mysqld]
enforce-config-setting-validation = OFF

# 字符集与时区
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = "+00:00"

# 存储引擎
default-storage-engine = InnoDB

# 连接与超时
max_connections = 200
wait_timeout = 28800
interactive_timeout = 28800

# 慢查询（开发观察用）
slow_query_log = 1
long_query_time = 1

[client]
default-character-set = utf8mb4
