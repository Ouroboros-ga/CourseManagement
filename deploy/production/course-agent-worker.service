[Unit]
Description=CourseManagement agent task worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=course-management
Group=course-management
WorkingDirectory=/opt/course-management/current/backend
EnvironmentFile=/etc/course-management/backend.env
ExecStart=/opt/course-management/current/backend/.venv/bin/python -m app.modules.agent.worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/course-management/files
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
