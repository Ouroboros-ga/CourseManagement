# 复制到 /etc/course-management/backend.env，root 所有，0600；不要提交实际凭证。
APP_ENV=prod
DEBUG=false
DATABASE_URL=mysql+pymysql://cm_runtime:GENERATED_PASSWORD@127.0.0.1:13308/course_management?charset=utf8mb4
SECRET_KEY=GENERATE_ON_SERVER
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CSRF_ALLOWED_ORIGINS=https://API_DOMAIN
CORS_ORIGINS=
FILE_STORAGE_BACKEND=local
FILE_LOCAL_STORAGE_DIR=/var/lib/course-management/files
WECHAT_LOGIN_ENABLED=false
ASSIGNMENT_MAX_TASKS_PER_WEEK=3
ASSIGNMENT_MAX_TASKS_PER_DAY=0
DEFAULT_SUBMISSION_DEADLINE_TIME=22:00
# 以下是技术默认值，业务期限另行确认；首次部署不启用自动到期删除。
FILE_RETENTION_SUBMISSION_PHOTO_DAYS=180
FILE_RETENTION_OBJECTION_PROOF_DAYS=180
FILE_RETENTION_REPORT_FILE_DAYS=365
FILE_RETENTION_TEMP_DAYS=1
FILE_RETENTION_IMPORT_FILE_DAYS=30
FILE_RETENTION_POLICY_VERSION=1
LOG_LEVEL=INFO
